# Copy to .env for local development. Never commit .env.
# Leave DATABASE_URL empty to use a local SQLite file (instance/storefront.db).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=owner
ADMIN_PASSWORD=pick-a-long-passphrase
FLASK_APP=wsgi.py
# STOREFRONT_ENV=production    # on the server: requires SECRET_KEY, enables secure cookies + HSTS
# ALLOWED_HOSTS=myshop.com,www.myshop.com

# Optional SMTP to email enquiries to the store owner
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Paystack secret key (sk_test_... or sk_live_...). Webhook URL: https://<domain>/paystack/webhook
PAYSTACK_SECRET_KEY=

# Support (superadmin) login shared by all your client stores. Generate with: flask superadmin-setup
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD_HASH=
SUPERADMIN_TOTP_SECRET=
